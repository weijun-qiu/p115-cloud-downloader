###############################################################################
# P115 Cloud Downloader Configuration
###############################################################################

# [Authentication]
# 115 Cookies (Required)
# You can obtain this by logging into 115.com in your browser, 
# then opening Developer Tools (F12) -> Network -> Headers of any request.
# Copy the entire 'Cookie' string.
P115_COOKIES="your_115_cookies_here"

# [Local Monitoring]
# Local directory to watch for new torrents and magnet links.
# You can use an absolute path or a path relative to the application directory.
# Default: ./watch
WATCH_DIR="./watch"

# Subdirectory where successfully processed files will be moved.
# This folder will be created inside the WATCH_DIR.
# Default: processed
PROCESSED_DIR="processed"

# [Cloud Target]
# Target path in your 115 Cloud Drive (e.g., /Downloads/Offline).
# The application will attempt to resolve this path to a Folder ID (CID).
# Default: /云下载
TARGET_PATH="/云下载"

# Alternatively, you can set the Target Folder ID (CID) directly.
# If this is set, TARGET_PATH will be ignored.
# Example: TARGET_CID="123456789"
TARGET_CID=""

# [Advanced Settings]
# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Set to DEBUG for more detailed output if you encounter issues.
LOG_LEVEL="INFO"

# Supported file extensions (comma-separated).
# The application will watch for these extensions.
# Note: .txt files will be checked for magnet links.
SUPPORTED_EXTENSIONS=".torrent,.magnet,.txt"

# Time to wait (in seconds) after a file is detected before processing it.
# This ensures the file is fully written to disk by your browser/client.
# Default: 1
SETTLE_TIME=1
